# ================================================
# LocaTech — .env.production.example
# Renomeie pra .env.production no servidor e preencha
# ================================================

# ---- Banco (gerenciado pelo docker-compose; user/senha vem do .env) ----
DATABASE_URL=postgresql://locatech_app:CHANGE_ME@postgres:5432/locatech?schema=public

# ---- Auth ----
NEXTAUTH_SECRET=GERAR_COM_openssl_rand_base64_32
NEXTAUTH_URL=https://locatech.com.br

# ---- Crons (Vercel-style; em VM use cron do sistema chamando o endpoint) ----
CRON_SECRET=GERAR_COM_openssl_rand_hex_32

# ---- Métricas ----
METRICS_TOKEN=GERAR_COM_openssl_rand_hex_32

# ---- Email ----
RESEND_API_KEY=re_...
EMAIL_FROM=LocaTech <noreply@locatech.com.br>

# ---- Mercado Pago (produção) ----
# Painel: https://www.mercadopago.com.br/developers/panel
# Access Token de PROD (começa com APP_USR-). Em test mode usa TEST-.
MP_ACCESS_TOKEN=APP_USR-...
# Secret do webhook (Painel → Webhooks → criar notificação → copia o "Secret")
MP_WEBHOOK_SECRET=...
# Public key não é necessária pro fluxo de checkout redirect (preapproval).
MP_PUBLIC_KEY=APP_USR-...

# ---- Push Notifications ----
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:contato@locatech.com.br

# ---- Sentry (opcional) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Backup S3 (opcional) ----
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=locatech/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1

# ---- Super-admin ----
ADMIN_EMAILS=vitorrobertonunes@hotmail.com
